        #region FindElementAsync - Current Strategy Success

        [Test(Description = "Verify FindElementAsync returns element when current strategy succeeds")]
        public async Task FindElementAsync_CurrentStrategySucceeds_ShouldReturnElement()
        {
            // Arrange
            var selector = "#submit-button";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            var selfHealing = new SelfHealingLocators(_mockPage, selector);

            // Act
            var result = await selfHealing.FindElementAsync();

            // Assert
            result.Should().NotBeNull();
            result.Should().Be(_mockLocator);
            await _mockLocator.Received(1).WaitForAsync(Arg.Any<LocatorWaitForOptions>());
        }

