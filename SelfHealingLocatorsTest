        #region FindElementAsync - Retry Attempts

        [Test(Description = "Verify FindElementAsync exhausts all retry attempts before failing")]
        public void FindElementAsync_AllStrategiesFail_ShouldThrowAfterRetries()
        {
            // Arrange
            var selector = "#non-existent-button";
            _mockPage.Locator(Arg.Any<string>()).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>())
                .Throws(new TimeoutException("Element not found"));

            var selfHealing = new SelfHealingLocators(_mockPage, selector);

            // Act & Assert
            var exception = Assert.ThrowsAsync<PlaywrightException>(
                async () => await selfHealing.FindElementAsync(retryAttempts: 0));

            exception!.Message.Should().Contain("Failed to locate element after all healing attempts");
            exception.Message.Should().Contain(selector);
        }

