        #region Concurrent Access Tests

        [Test(Description = "Verify SelfHealingLocators can handle concurrent FindElementAsync calls")]
        public async Task FindElementAsync_ConcurrentCalls_ShouldHandleAll()
        {
            // Arrange
            var selector = "#concurrent-element";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            var selfHealing = new SelfHealingLocators(_mockPage, selector);

            // Act
            var task1 = selfHealing.FindElementAsync();
            var task2 = selfHealing.FindElementAsync();
            var task3 = selfHealing.FindElementAsync();

            var results = await Task.WhenAll(task1, task2, task3);

            // Assert
            results.Should().HaveCount(3);
            results.Should().AllSatisfy(r => r.Should().NotBeNull());
        }

