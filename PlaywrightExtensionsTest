        [Test(Description = "Verify FillAsync with multiple sequential fills")]
        public async Task FillAsync_MultipleFills_ShouldHandleAll()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.FillAsync(Arg.Any<string>(), Arg.Any<LocatorFillOptions>()).Returns(Task.CompletedTask);

            // Act
            await locatorTask.FillAsync("first");
            await locatorTask.FillAsync("second");
            await locatorTask.FillAsync("third");

            // Assert
            await _mockLocator.Received(3).FillAsync(Arg.Any<string>(), Arg.Any<LocatorFillOptions>());
        }

        #endregion

        #region GetTextAsync Extension Tests

        [Test(Description = "Verify GetTextAsync extension method retrieves text from element")]
        public async Task GetTextAsync_ValidLocator_ShouldReturnText()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            var expectedText = "Button Text";
            _mockLocator.InnerTextAsync(Arg.Any<LocatorInnerTextOptions>()).Returns(expectedText);

            // Act
            var result = await locatorTask.GetTextAsync();

            // Assert
            result.Should().Be(expectedText);
            await _mockLocator.Received(1).InnerTextAsync(Arg.Any<LocatorInnerTextOptions>());
        }

        [Test(Description = "Verify GetTextAsync returns empty string")]
        public async Task GetTextAsync_EmptyText_ShouldReturnEmpty()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.InnerTextAsync(Arg.Any<LocatorInnerTextOptions>()).Returns("");

            // Act
            var result = await locatorTask.GetTextAsync();

            // Assert
            result.Should().BeEmpty();
        }

        [Test(Description = "Verify GetTextAsync with multiline text")]
        public async Task GetTextAsync_MultilineText_ShouldReturnAll()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            var expectedText = "Line 1\nLine 2\nLine 3";
            _mockLocator.InnerTextAsync(Arg.Any<LocatorInnerTextOptions>()).Returns(expectedText);

            // Act
            var result = await locatorTask.GetTextAsync();

            // Assert
            result.Should().Be(expectedText);
            result.Should().Contain("Line 1");
            result.Should().Contain("Line 2");
            result.Should().Contain("Line 3");
        }

        [Test(Description = "Verify GetTextAsync with whitespace")]
        public async Task GetTextAsync_WhitespaceText_ShouldPreserve()
