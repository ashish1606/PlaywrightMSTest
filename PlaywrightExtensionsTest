        [Test(Description = "Verify GetTextAsync multiple times returns updated text")]
        public async Task GetTextAsync_MultipleCalls_ShouldReturnEachTime()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.InnerTextAsync(Arg.Any<LocatorInnerTextOptions>())
