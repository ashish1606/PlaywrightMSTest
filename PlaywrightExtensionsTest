using ExpleoPlaywright.LLM.SelfHealing.Utils.Extensions;
using FluentAssertions;
using Microsoft.Playwright;
using NSubstitute;
using NUnit.Framework;

namespace ExpleoPlaywright.LLM.SelfHealing.Tests
{
    /// <summary>
    /// Unit tests for PlaywrightExtensions class which provides extension methods
    /// for IPage and Task&lt;ILocator&gt; to simplify Playwright interactions.
    /// </summary>
    [TestFixture]
    [Category("Unit")]
    [Category("Extensions")]
    public class PlaywrightExtensionsTest
    {
        private IPage _mockPage;
        private ILocator _mockLocator;

        [SetUp]
        public void Setup()
        {
            _mockPage = Substitute.For<IPage>();
            _mockLocator = Substitute.For<ILocator>();
        }

        #region AiFindElementAsync Tests

        [Test(Description = "Verify AiFindElementAsync extension method returns locator")]
        public async Task AiFindElementAsync_ValidSelector_ShouldReturnLocator()
        {
            // Arrange
            var selector = "#submit-button";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector);

            // Assert
            result.Should().NotBeNull();
        }

        [Test(Description = "Verify AiFindElementAsync with semantic context")]
        public async Task AiFindElementAsync_WithSemanticContext_ShouldPass()
        {
            // Arrange
            var selector = "#login-btn";
            var semanticContext = "Login button on the authentication page";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector, semanticContext);

            // Assert
            result.Should().NotBeNull();
        }

        [Test(Description = "Verify AiFindElementAsync without semantic context")]
        public async Task AiFindElementAsync_WithoutSemanticContext_ShouldWork()
        {
            // Arrange
            var selector = ".btn-primary";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector);

            // Assert
            result.Should().NotBeNull();
        }

        [Test(Description = "Verify AiFindElementAsync with null semantic context")]
        public async Task AiFindElementAsync_NullSemanticContext_ShouldWork()
        {
            // Arrange
            var selector = "#element";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector, null);

            // Assert
            result.Should().NotBeNull();
        }

        [Test(Description = "Verify AiFindElementAsync with various selector types")]
        [TestCase("#id-selector")]
        [TestCase(".class-selector")]
        [TestCase("//xpath/selector")]
        [TestCase("text=Click Me")]
        [TestCase("role=button")]
        [TestCase("[data-testid='test-id']")]
        public async Task AiFindElementAsync_VariousSelectorTypes_ShouldAcceptAll(string selector)
        {
            // Arrange
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector);

            // Assert
            result.Should().NotBeNull();
        }

        [Test(Description = "Verify AiFindElementAsync with empty selector")]
        public async Task AiFindElementAsync_EmptySelector_ShouldHandle()
        {
            // Arrange
            var selector = "";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector);

            // Assert
            result.Should().NotBeNull();
        }

        #endregion

        #region ClickAsync Extension Tests

        [Test(Description = "Verify ClickAsync extension method clicks the element")]
        public async Task ClickAsync_ValidLocator_ShouldClick()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.ClickAsync(Arg.Any<LocatorClickOptions>()).Returns(Task.CompletedTask);

            // Act
            await locatorTask.ClickAsync();

            // Assert
            await _mockLocator.Received(1).ClickAsync(Arg.Any<LocatorClickOptions>());
        }

        [Test(Description = "Verify ClickAsync waits for task to complete before clicking")]
        public async Task ClickAsync_AsyncLocator_ShouldWaitAndClick()
        {
            // Arrange
            var tcs = new TaskCompletionSource<ILocator>();
            var locatorTask = tcs.Task;
            _mockLocator.ClickAsync(Arg.Any<LocatorClickOptions>()).Returns(Task.CompletedTask);

            // Start the extension method
            var clickTask = locatorTask.ClickAsync();

            // Complete the task after a delay
            await Task.Delay(10);
            tcs.SetResult(_mockLocator);

            // Act
            await clickTask;

            // Assert
            await _mockLocator.Received(1).ClickAsync(Arg.Any<LocatorClickOptions>());
        }

        [Test(Description = "Verify ClickAsync handles multiple sequential clicks")]
        public async Task ClickAsync_MultipleClicks_ShouldHandleAll()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.ClickAsync(Arg.Any<LocatorClickOptions>()).Returns(Task.CompletedTask);

            // Act
            await locatorTask.ClickAsync();
            await locatorTask.ClickAsync();
            await locatorTask.ClickAsync();

            // Assert
            await _mockLocator.Received(3).ClickAsync(Arg.Any<LocatorClickOptions>());
        }

        #endregion

        #region FillAsync Extension Tests

