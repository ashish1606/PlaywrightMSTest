            // Act
            var result = await locatorTask.GetTextAsync();

            // Assert
            result.Should().Be(expectedText);
        }

        [Test(Description = "Verify GetTextAsync waits for locator task to complete")]
        public async Task GetTextAsync_AsyncLocator_ShouldWaitAndGetText()
        {
            // Arrange
            var tcs = new TaskCompletionSource<ILocator>();
            var locatorTask = tcs.Task;
