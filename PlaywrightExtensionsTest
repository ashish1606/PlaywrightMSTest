            var locatorTask = Task.FromResult(_mockLocator);
            var text = "test@example.com";
            _mockLocator.FillAsync(text, Arg.Any<LocatorFillOptions>()).Returns(Task.CompletedTask);

            // Act
            await locatorTask.FillAsync(text);

            // Assert
            await _mockLocator.Received(1).FillAsync(text, Arg.Any<LocatorFillOptions>());
        }

