            // Act
            var result1 = await locatorTask.GetTextAsync();
            var result2 = await locatorTask.GetTextAsync();
            var result3 = await locatorTask.GetTextAsync();

            // Assert
            result1.Should().Be("First");
            result2.Should().Be("Second");
            result3.Should().Be("Third");
        }

        #endregion

        #region Combined Extension Method Tests

        [Test(Description = "Verify extension methods can be chained")]
        public async Task ExtensionMethods_Chained_ShouldWorkTogether()
        {
            // Arrange
            var selector = "#username";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);
            _mockLocator.FillAsync(Arg.Any<string>(), Arg.Any<LocatorFillOptions>()).Returns(Task.CompletedTask);

            // Act
            var locator = _mockPage.AiFindElementAsync(selector);
            await locator.FillAsync("test-user");

            // Assert
            await _mockLocator.Received(1).FillAsync("test-user", Arg.Any<LocatorFillOptions>());
        }

        [Test(Description = "Verify AiFindElementAsync followed by ClickAsync")]
        public async Task AiFindElementAsync_ThenClick_ShouldWork()
        {
            // Arrange
            var selector = "#submit-btn";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);
            _mockLocator.ClickAsync(Arg.Any<LocatorClickOptions>()).Returns(Task.CompletedTask);

            // Act
            await _mockPage.AiFindElementAsync(selector).ClickAsync();

            // Assert
            await _mockLocator.Received(1).ClickAsync(Arg.Any<LocatorClickOptions>());
        }

        [Test(Description = "Verify AiFindElementAsync followed by GetTextAsync")]
        public async Task AiFindElementAsync_ThenGetText_ShouldWork()
        {
            // Arrange
            var selector = "#message";
            var expectedText = "Success!";
            _mockPage.Locator(selector).Returns(_mockLocator);
            _mockLocator.WaitForAsync(Arg.Any<LocatorWaitForOptions>()).Returns(Task.CompletedTask);
            _mockLocator.InnerTextAsync(Arg.Any<LocatorInnerTextOptions>()).Returns(expectedText);

            // Act
            var result = await _mockPage.AiFindElementAsync(selector).GetTextAsync();

            // Assert
            result.Should().Be(expectedText);
        }

        #endregion

        #region Error Handling Tests

        [Test(Description = "Verify ClickAsync propagates exceptions")]
        public void ClickAsync_ElementNotClickable_ShouldThrow()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.When(x => x.ClickAsync(Arg.Any<LocatorClickOptions>()))
                .Do(x => throw new PlaywrightException("Element is not clickable"));

            // Act & Assert
            Assert.ThrowsAsync<PlaywrightException>(async () => await locatorTask.ClickAsync());
        }

        [Test(Description = "Verify FillAsync propagates exceptions")]
        public void FillAsync_ElementNotEditable_ShouldThrow()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.When(x => x.FillAsync(Arg.Any<string>(), Arg.Any<LocatorFillOptions>()))
                .Do(x => throw new PlaywrightException("Element is not editable"));

            // Act & Assert
            Assert.ThrowsAsync<PlaywrightException>(async () => await locatorTask.FillAsync("text"));
        }

        [Test(Description = "Verify GetTextAsync propagates exceptions")]
        public void GetTextAsync_ElementNotFound_ShouldThrow()
        {
            // Arrange
            var locatorTask = Task.FromResult(_mockLocator);
            _mockLocator.InnerTextAsync(Arg.Any<LocatorInnerTextOptions>())
                .Returns<string>(x => throw new PlaywrightException("Element not found"));

            // Act & Assert
            Assert.ThrowsAsync<PlaywrightException>(async () => await locatorTask.GetTextAsync());
        }

        #endregion
    }
