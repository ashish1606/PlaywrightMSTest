        {
            // Create a mock LLM client
            _mockLLMClient = Substitute.For<LLMClient>();

            // Sample HTML page source for testing
            _samplePageSource = @"
                <html>
                <body>
                    <button id='submit-btn' class='btn btn-primary' data-testid='submit-button' role='button'>Submit</button>
                    <input type='text' name='username' placeholder='Enter username' />
