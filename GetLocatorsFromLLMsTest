        [Test(Description = "Verify LocatorSuggestions handles empty JSON object")]
        public void LocatorSuggestions_EmptyJSON_ShouldReturnObject()
        {
            // Arrange
            var emptyJson = "{}";

            // Act
            var result = JsonSerializer.Deserialize<LocatorSuggestions>(emptyJson);

            // Assert
            result.Should().NotBeNull();
        }

        [Test(Description = "Verify LocatorSuggestions handles escaped characters in JSON")]
        public void LocatorSuggestions_EscapedCharacters_ShouldParse()
        {
            // Arrange
            var jsonResponse = @"{
                ""id"": ""test\""id"",
                ""xpath"": ""//div[@class='test\\nclass']"",
                ""text"": ""Button\tText"",
                ""title"": """",
                ""name"": """",
                ""cssSelector"": """",
                ""className"": """",
                ""linkText"": """",
                ""role"": """",
                ""testId"": """",
                ""placeholder"": """"
            }";

            // Act
            var result = JsonSerializer.Deserialize<LocatorSuggestions>(jsonResponse);

            // Assert
            result.Should().NotBeNull();
            result!.id.Should().Contain("\"");
            result.text.Should().Contain("\t");
        }

        #endregion

        #region Semantic Context Description Tests

        [Test(Description = "Verify element description with semantic context")]
        public void ElementDescription_WithSemanticContext_ShouldFormatCorrectly()
        {
            // Arrange
            var semanticContext = "Submit button for login form";
            var locatorType = "id";
            var originalLocator = "old-submit-btn";

            // Act
            var expectedDescription = $"'{semanticContext}' (Original locator: {locatorType}={originalLocator})";

            // Assert
            expectedDescription.Should().Contain(semanticContext);
            expectedDescription.Should().Contain("Original locator:");
            expectedDescription.Should().Contain(locatorType);
            expectedDescription.Should().Contain(originalLocator);
        }

        [Test(Description = "Verify element description without semantic context")]
        public void ElementDescription_WithoutSemanticContext_ShouldUseTechnicalInfo()
        {
            // Arrange
            var locatorType = "xpath";
            var originalLocator = "//button[@id='submit']";

            // Act
            var expectedDescription = $"element with locatorType: {locatorType} and locator: {originalLocator}";

            // Assert
            expectedDescription.Should().Contain("element with locatorType:");
            expectedDescription.Should().Contain(locatorType);
            expectedDescription.Should().Contain(originalLocator);
            expectedDescription.Should().NotContain("Original locator:");
        }

        [Test(Description = "Verify element description with empty semantic context uses technical info")]
        public void ElementDescription_EmptySemanticContext_ShouldUseTechnicalInfo()
        {
            // Arrange
            var semanticContext = "   ";
            var locatorType = "css";
            var originalLocator = ".button";

            // Act
            var isWhitespace = string.IsNullOrWhiteSpace(semanticContext);
            var description = isWhitespace 
                ? $"element with locatorType: {locatorType} and locator: {originalLocator}"
                : $"'{semanticContext}' (Original locator: {locatorType}={originalLocator})";

            // Assert
            description.Should().Contain("element with locatorType:");
            description.Should().Contain(locatorType);
            description.Should().Contain(originalLocator);
        }

        #endregion

