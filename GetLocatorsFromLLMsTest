        #region GetHealedLocator Tests

        [Test(Description = "Verify GetHealedLocator returns valid LocatorSuggestions")]
        public async Task GetHealedLocator_ValidResponse_ShouldReturnSuggestions()
        {
            // Arrange
            var jsonResponse = @"{
                ""id"": ""submit-btn"",
                ""name"": ""submitButton"",
                ""xpath"": ""//button[@id='submit-btn']"",
                ""cssSelector"": ""#submit-btn"",
                ""className"": ""btn btn-primary"",
                ""linkText"": ""Submit"",
                ""role"": ""button"",
                ""testId"": ""submit-button"",
                ""placeholder"": """",
                ""text"": ""Submit"",
                ""title"": """"
            }";

            _mockLLMClient.GetCompletionAsync(Arg.Any<string>()).Returns(jsonResponse);

            // Act
            var result = await GetLocatorsFromLLMs.GetHealedLocator(
                _mockLLMClient,
                _samplePageSource,
                "id",
                "old-submit-btn");

            // Assert
            result.Should().NotBeNull();
            result!.id.Should().Be("submit-btn");
            result.xpath.Should().Be("//button[@id='submit-btn']");
            result.cssSelector.Should().Be("#submit-btn");
            result.role.Should().Be("button");
            result.testId.Should().Be("submit-button");
        }

