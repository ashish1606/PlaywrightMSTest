        #region Prompt Structure Tests

        [Test(Description = "Verify prompt should include critical instructions")]
        public void PromptStructure_ShouldIncludeCriticalInstructions()
        {
            // Arrange
            var expectedKeywords = new[] 
            { 
                "JSON", "id", "xpath", "cssSelector", "role", "testId",
                "placeholder", "text", "title", "className", "name", "linkText"
            };

            // Act - We're testing that a proper prompt would contain these keywords
            var samplePrompt = @"Return ONLY a valid JSON object with these keys:
                id, name, xpath, cssSelector, className, linkText, role, testId, placeholder, text, title";

            // Assert
            foreach (var keyword in expectedKeywords)
            {
                samplePrompt.Should().Contain(keyword);
            }
        }

