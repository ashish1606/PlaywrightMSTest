    /// <summary>
    /// Unit tests for GetLocatorsFromLLMs class which provides AI-powered locator healing functionality.
    /// Note: These are integration tests that test the prompt construction and JSON parsing logic.
    /// Actual LLM calls are not made in these tests.
    /// </summary>
    [TestFixture]
    [Category("Unit")]
    [Category("LLM")]
    public class GetLocatorsFromLLMsTest
    {
        private string _samplePageSource;

        [SetUp]
        public void Setup()
        {
            // Sample HTML page source for testing
            _samplePageSource = @"
                <html>
                <body>
                    <button id='submit-btn' class='btn btn-primary' data-testid='submit-button' role='button'>Submit</button>
                    <input type='text' name='username' placeholder='Enter username' />
                    <a href='#' title='Home Link'>Home</a>
                </body>
                </html>";
        }

        #region LocatorSuggestions Parsing Tests

        [Test(Description = "Verify LocatorSuggestions can be parsed from valid JSON")]
        public void LocatorSuggestions_ParseValidJSON_ShouldSucceed()
        {
            // Arrange
            var jsonResponse = @"{
                ""id"": ""submit-btn"",
                ""name"": ""submitButton"",
                ""xpath"": ""//button[@id='submit-btn']"",
                ""cssSelector"": ""#submit-btn"",
                ""className"": ""btn btn-primary"",
                ""linkText"": ""Submit"",
                ""role"": ""button"",
                ""testId"": ""submit-button"",
                ""placeholder"": """",
                ""text"": ""Submit"",
                ""title"": """"
            }";

            // Act
            var result = JsonSerializer.Deserialize<LocatorSuggestions>(jsonResponse);

            // Assert
            result.Should().NotBeNull();
            result!.id.Should().Be("submit-btn");
            result.xpath.Should().Be("//button[@id='submit-btn']");
            result.cssSelector.Should().Be("#submit-btn");
            result.role.Should().Be("button");
            result.testId.Should().Be("submit-button");
        }

        [Test(Description = "Verify LocatorSuggestions handles all selector types")]
        public void LocatorSuggestions_AllSelectorTypes_ShouldParse()
        {
            // Arrange
            var jsonResponse = @"{
                ""id"": ""element-id"",
                ""name"": ""element-name"",
                ""xpath"": ""//div[@id='test']"",
                ""cssSelector"": ""#element-id"",
                ""className"": ""class1 class2"",
                ""linkText"": ""Click Here"",
                ""role"": ""button"",
                ""testId"": ""test-id"",
                ""placeholder"": ""Enter text"",
                ""text"": ""Button Text"",
                ""title"": ""Element Title""
            }";

            // Act
            var result = JsonSerializer.Deserialize<LocatorSuggestions>(jsonResponse);

            // Assert
            result.Should().NotBeNull();
            result!.id.Should().Be("element-id");
            result.name.Should().Be("element-name");
            result.xpath.Should().Be("//div[@id='test']");
            result.cssSelector.Should().Be("#element-id");
            result.className.Should().Be("class1 class2");
            result.linkText.Should().Be("Click Here");
            result.role.Should().Be("button");
            result.testId.Should().Be("test-id");
            result.placeholder.Should().Be("Enter text");
            result.text.Should().Be("Button Text");
            result.title.Should().Be("Element Title");
        }

        [Test(Description = "Verify LocatorSuggestions handles partial response with empty values")]
        public void LocatorSuggestions_PartialResponse_ShouldHandleEmptyValues()
        {
            // Arrange
            var jsonResponse = @"{
                ""id"": ""submit-btn"",
                ""name"": """",
                ""xpath"": ""//button"",
                ""cssSelector"": """",
                ""className"": """",
                ""linkText"": """",
                ""role"": ""button"",
                ""testId"": ""submit-test"",
                ""placeholder"": """",
                ""text"": """",
                ""title"": """"
            }";

            // Act
            var result = JsonSerializer.Deserialize<LocatorSuggestions>(jsonResponse);

            // Assert
            result.Should().NotBeNull();
            result!.id.Should().Be("submit-btn");
            result.name.Should().BeEmpty();
            result.xpath.Should().Be("//button");
            result.cssSelector.Should().BeEmpty();
            result.role.Should().Be("button");
