                _mockLLMClient,
                _samplePageSource,
                "id",
                "old-id");

            // Assert
            result.Should().NotBeNull();
            // JSON null values are deserialized as C# null, which becomes empty string for string properties
            result!.name.Should().Be("test");
            result.cssSelector.Should().Be("#test");
        }

