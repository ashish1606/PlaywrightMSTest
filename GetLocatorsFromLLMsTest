using ExpleoPlaywright.LLM.SelfHealing.Utils.LLM;
using ExpleoPlaywright.LLM.SelfHealing.Utils.Modals;
using FluentAssertions;
using NSubstitute;
using NUnit.Framework;
using System.Text.Json;

namespace ExpleoPlaywright.LLM.SelfHealing.Tests
