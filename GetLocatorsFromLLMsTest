        [Test(Description = "Verify LocatorSuggestions handles null values in JSON")]
        public void LocatorSuggestions_NullValuesInJSON_ShouldHandleGracefully()
        {
            // Arrange
            var jsonResponse = @"{
                ""id"": null,
                ""name"": ""test"",
                ""xpath"": null,
                ""cssSelector"": ""#test"",
                ""className"": null,
                ""linkText"": null,
                ""role"": null,
                ""testId"": null,
                ""placeholder"": null,
                ""text"": null,
                ""title"": null
